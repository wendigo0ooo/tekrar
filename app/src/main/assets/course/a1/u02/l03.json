  "grammar": [
    {
      "title_tr": "What do you do? / I'm a ...",
      "explanation_tr": "Mesleğini sormak için 'What do you do?' denir. Cevap 'I'm a ...' kalıbıyla verilir: I'm a teacher.",
      "examples": [
        { "en": "What do you do?", "tr": "Ne iş yapıyorsun?" },
        { "en": "I'm a teacher.", "tr": "Öğretmenim." }
      ]
    },
    {
      "title_tr": "a / an",
      "explanation_tr": "Meslekten önce 'a' ya da 'an' kullanılır. Ünsüz sesle başlayan mesleklerde 'a': a teacher. Ünlü sesle başlayanlarda 'an': an engineer. 'an' söylenişe göre seçilir.",
      "examples": [
        { "en": "I'm a doctor.", "tr": "Doktorum." },
        { "en": "I'm an engineer.", "tr": "Mühendisim." }
      ]
    }
  ],
  "dialogue": {
    "title": "Ne iş yapıyorsun?",
    "lines": [
      { "speaker": "Mia", "en": "Hi, Leo! What do you do?", "tr": "Merhaba Leo! Ne iş yapıyorsun?" },
      { "speaker": "Leo", "en": "I'm an engineer. And you?", "tr": "Mühendisim. Ya sen?" },
      { "speaker": "Mia", "en": "I'm a teacher. I'm an English teacher.", "tr": "Öğretmenim. İngilizce öğretmeniyim." },
      { "speaker": "Leo", "en": "Nice! My job is great.", "tr": "Güzel! İşim harika." },
      { "speaker": "Mia", "en": "My job is great, too.", "tr": "Benim işim de harika." },
      { "speaker": "Leo", "en": "Great! See you, Mia.", "tr": "Harika! Görüşürüz, Mia." }
    ]
