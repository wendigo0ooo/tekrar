  "grammar": [
    {
      "title_tr": "What is your name? / My name is ...",
      "explanation_tr": "Adını sorarken 'What is your name?' denir. Cevap 'My name is ...' ile verilir. Günlük dilde 'What's your name?' ve 'My name's ...' kısa biçimleri kullanılır.",
      "examples": [
        { "en": "What's your name?", "tr": "Adın ne?" },
        { "en": "My name is Leo.", "tr": "Benim adım Leo." }
      ]
    },
    {
      "title_tr": "This is ... / my, your",
      "explanation_tr": "Birini tanıtırken 'This is ...' kullanılır: This is my friend Mia. 'my' benim, 'your' senin demektir.",
      "examples": [
        { "en": "This is my friend Sam.", "tr": "Bu arkadaşım Sam." },
        { "en": "You are my friend.", "tr": "Sen benim arkadaşımsın." }
      ]
    }
  ],
  "dialogue": {
    "title": "Partide tanışma",
    "lines": [
      { "speaker": "Mia", "en": "Hi! What's your name?", "tr": "Merhaba! Adın ne?" },
