      { "speaker": "Mia", "en": "I'm Mia. This is my friend Sam.", "tr": "Ben Mia. Bu arkadaşım Sam." },
      { "speaker": "Leo", "en": "Nice to meet you, Sam.", "tr": "Tanıştığıma memnun oldum, Sam." },
      { "speaker": "Sam", "en": "Nice to meet you too, Leo.", "tr": "Ben de tanıştığıma memnun oldum, Leo." }
    ]
  },
