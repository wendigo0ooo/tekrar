  "grammar": [
    {
      "title_tr": "Saat sorma ve söyleme",
      "explanation_tr": "Saat sorarken 'What time is it?' denir. Tam saatlerde sayı ve 'o'clock' kullanılır: It's seven o'clock. Bir olayın saatini söylerken 'at' eklenir: at seven o'clock.",
      "examples": [
        { "en": "What time is it? It's seven o'clock.", "tr": "Saat kaç? Saat yedi." },
        { "en": "I get up at seven o'clock.", "tr": "Yedide kalkarım." }
      ]
    },
    {
      "title_tr": "Günün bölümleri",
      "explanation_tr": "Günün bölümleri morning, afternoon, evening ve night'tır. Gündüz bölümleriyle 'in' kullanılır: in the morning, in the evening. Gece için 'at night' denir.",
      "examples": [
        { "en": "I work in the afternoon.", "tr": "Öğleden sonra çalışırım." },
        { "en": "I sleep at night.", "tr": "Gece uyurum." }
      ]
    }
  ],
  "dialogue": {
    "title": "Saat kaç?",
    "lines": [
      { "speaker": "Anna", "en": "What time is it?", "tr": "Saat kaç?" },
      { "speaker": "Ben", "en": "It's seven o'clock.", "tr": "Saat yedi." },
      { "speaker": "Anna", "en": "Thanks! I get up at seven in the morning.", "tr": "Teşekkürler! Sabah yedide kalkarım." },
      { "speaker": "Ben", "en": "I get up at eight.", "tr": "Ben sekizde kalkarım." },
      { "speaker": "Anna", "en": "Eight is early too!", "tr": "Sekiz de erken!" },
      { "speaker": "Ben", "en": "Yes! See you in the evening!", "tr": "Evet! Akşam görüşürüz!" }
    ]
  },
  "teach": [
    {
      "title_tr": "Günün bölümleri",
      "body_tr": "Morning sabah, afternoon öğleden sonra, evening akşam, night gece demektir. Selamlaşırken 'Good morning' ve 'Good evening' kullanılır. Gece için 'Good night' yalnız ayrılırken söylenir.",
      "examples": [
        { "en": "Good morning!", "tr": "Günaydın!" },
        { "en": "Good evening!", "tr": "İyi akşamlar!" }
      ],
      "tip_tr": "Sabah erken saatler için 'early' diyebilirsin: I get up early."
    },
    {
      "title_tr": "Saat söyleme",
      "body_tr": "Saat sormak için 'What time is it?' denir. Tam saatlerde sayı ve 'o'clock' kullanılır. Bir saatle birlikte 'at' kullanılır: at seven o'clock.",
      "examples": [
        { "en": "It's seven o'clock.", "tr": "Saat yedi." },
        { "en": "I get up at seven o'clock.", "tr": "Yedide kalkarım." }
      ],
      "tip_tr": "Günlük dilde 'It's seven.' de anlaşılır."
    }
  ],
